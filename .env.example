# ==============================================================================
# Nigeria Mass Weddings Map — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ==============================================================================

# ------------------------------------------------------------------------------
# MAPBOX (REQUIRED)
# Renders the basemap. https://account.mapbox.com/access-tokens/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ------------------------------------------------------------------------------
# VALYU (REQUIRED TO REBUILD OR RESEARCH)
# Powers the news search, the structured extraction of ceremonies, the FAAC
# figures, and the per-state briefings. The committed dataset in data/ renders
# without it — you only need a key to rebuild, or to use Live Feed and Intel.
# https://platform.valyu.ai
# ------------------------------------------------------------------------------
VALYU_API_KEY=valyu_your_api_key_here

# ------------------------------------------------------------------------------
# OPENAI (RECOMMENDED)
# Turns each article into a structured record — state, date, couples, cost,
# sponsor. Without it the pipeline falls back to keyword extraction, which is
# much blunter and will miss ceremonies.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4.1-mini

# ------------------------------------------------------------------------------
# APP MODE
# 'self-hosted' (default) runs every Valyu call on the key above — fine for local
# use. 'valyu' puts Live Feed and Intel behind a sign-in, so those searches are
# billed to whoever is signed in rather than to you.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_MODE=self-hosted

# ------------------------------------------------------------------------------
# PUBLIC SITE URL
# ------------------------------------------------------------------------------
# The absolute origin the site is served from, no trailing slash. Open Graph and
# Twitter reject relative image URLs, so link previews only render once this is
# set in production. On Railway you can leave it blank — RAILWAY_PUBLIC_DOMAIN is
# injected into the build and used automatically. Falls back to localhost:3000.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://weddingbelt.up.railway.app

# ------------------------------------------------------------------------------
# VALYU OAUTH (only needed when NEXT_PUBLIC_APP_MODE=valyu)
# Contact contact@valyu.ai for OAuth credentials — they are not self-serve.
# NEXT_PUBLIC_REDIRECT_URI must match the port you are actually serving on. If
# `next dev` falls back to 3001 because 3000 is taken, update it or the callback
# lands on whatever else is running there.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_VALYU_AUTH_URL=https://auth.valyu.ai
# NEXT_PUBLIC_VALYU_CLIENT_ID=your-oauth-client-id
# VALYU_CLIENT_SECRET=your-oauth-client-secret
# VALYU_APP_URL=https://platform.valyu.ai
# NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/valyu/callback

# ------------------------------------------------------------------------------
# REBUILDS (OPTIONAL)
# Set to "false" on a public deployment to disable the Rebuild button and the
# POST /api/weddings endpoint, so visitors cannot spend your API credits.
# ------------------------------------------------------------------------------
# ALLOW_REBUILD=false
